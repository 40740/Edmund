---
interface Props {
  src: string;
  alt: string;
  loading?: "eager" | "lazy";
}

const { src, alt, loading = "lazy" } = Astro.props;
---

<div class="shot group" data-shot-item data-open="false">
  <button class="shot-summary flex w-full cursor-zoom-in flex-col gap-2 text-left" type="button" aria-expanded="false">
    <img class="shot-preview h-auto w-full rounded-[8px]" src={src} alt={alt} loading={loading} />
  </button>

  <div class="shot-overlay" aria-hidden="true">
    <button class="shot-backdrop" type="button" aria-label="Close screenshot"></button>
    <div class="shot-modal" role="dialog" aria-modal="true">
      <button class="shot-close" type="button" aria-label="Close screenshot">
        <span class="i-lucide-x block h-5 w-5" aria-hidden="true"></span>
      </button>
      <img class="shot-full h-auto w-full rounded-[10px]" src={src} alt={alt} loading="lazy" />
    </div>
  </div>
</div>

<style>
  .shot-preview {
    transition: transform 400ms ease-in-out;
  }

  .shot:hover .shot-preview {
    transform: scale(1.01);
  }

  .shot-overlay {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100vw;
    max-width: none;
    height: 100vh;
    padding: 1rem;
    background: transparent;
    opacity: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 50;
    transition: opacity 200ms linear;
  }

  .shot-overlay::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    opacity: 0;
    transition: opacity 200ms linear;
  }

  .shot[data-open="true"] .shot-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .shot[data-open="true"] .shot-overlay::before {
    opacity: 1;
  }

  .shot-modal {
    position: relative;
    z-index: 1;
    max-width: min(92vw, 1200px);
    max-height: 88vh;
    transform: scale(0.98) translateY(0.5rem);
    opacity: 0;
    transition: transform 200ms linear, opacity 200ms linear;
  }

  .shot[data-open="true"] .shot-modal {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .shot-full {
    display: block;
    max-height: 88vh;
    width: auto;
    max-width: 92vw;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .shot-close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.18);
  }

  .shot-backdrop {
    position: fixed;
    inset: 0;
    border: 0;
    background: transparent;
  }
</style>

<script>
  const setupScreenshots = () => {
    document.querySelectorAll("[data-shot-item]").forEach((item) => {
      if (!(item instanceof HTMLElement)) {
        return;
      }

      const button = item.querySelector("button");
      const overlay = item.querySelector(".shot-overlay");
      const backdrop = item.querySelector(".shot-backdrop");
      const closeButton = item.querySelector(".shot-close");

      if (!(button instanceof HTMLButtonElement) || !(overlay instanceof HTMLElement) || !(backdrop instanceof HTMLButtonElement) || !(closeButton instanceof HTMLButtonElement)) {
        return;
      }

      if (button.dataset.bound === "true") {
        return;
      }

      const openOverlay = () => {
        item.dataset.open = "true";
        button.setAttribute("aria-expanded", "true");
        overlay.setAttribute("aria-hidden", "false");
      };

      const closeOverlay = () => {
        item.dataset.open = "false";
        button.setAttribute("aria-expanded", "false");
        overlay.setAttribute("aria-hidden", "true");
      };

      button.dataset.bound = "true";
      button.addEventListener("click", openOverlay);
      backdrop.addEventListener("click", closeOverlay);
      closeButton.addEventListener("click", closeOverlay);

      overlay.addEventListener("click", (event) => {
        if (event.target === overlay) {
          closeOverlay();
        }
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupScreenshots, { once: true });
  } else {
    setupScreenshots();
  }
</script>
