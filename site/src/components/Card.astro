---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<div
  class="
    rounded-2xl
    border border-tertiary
    p-6
    transition-transform
    duration-200
    ease-out
    hover:scale-[1.01]
  "
>
  <h3 class="font-semibold mb-2">
    {title}
  </h3>

  <p class="leading-relaxed text-secondary">
    {text}
  </p>
</div>