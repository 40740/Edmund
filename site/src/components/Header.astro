---
const navItems = [
  { label: "download", href: "https://github.com/I7T5/Edmund/releases/latest" },
  { label: "source", href: "https://github.com/I7T5/Edmund" },
  { label: "roadmap", href: "https://github.com/I7T5/Edmund/blob/main/docs/ROADMAP.md" },
];

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="flex items-center justify-between gap-4 py-10 sm:py-14">
  <a class="font-mono text-sm font-semibold tracking-normal text-teal-dark" href={base}>
    Edmund
  </a>
  <nav class="flex flex-wrap justify-end gap-x-4 gap-y-2 text-sm text-quiet">
    {navItems.map((item) => (
      <a class="transition hover:text-teal-dark" href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>
