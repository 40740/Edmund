---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<footer class="mx-auto max-w-3xl px-6 sm:px-8 mt-8 mb-16">
  <hr class="py-2">
  <div class="flex mx-2">
    <a href="#">
      <figure class="justify-self-start sm:justify-self-end mr-2 my-1">
        <img
          class="h-8 w-8 sm:h-10 sm:w-10"
          src={`${base}assets/app-icon.png`}
          alt="Edmund app icon"
          loading="eager"
        />
      </figure>
    </a>
    <span class="text-secondary my-auto">
      © 2026 <a class="text-secondary hover:text-primary" href="https://i7t5.com">I7T5</a>
    </span>

    <span class="mx-auto"></span>

    <nav class="my-auto">
      <a class="text-secondary p-1 hover:text-yellow-500" href="https://github.com/I7T5/Edmund">Star on GitHub</a>
      <a class="text-secondary p-1" href="https://trello.com/b/vw2TveNI">Roadmap</a>
    </nav>
  </div>

</footer>
